#!/usr/bin/env python3
"""Report what this installation runs with, for a bug report and to compare with the walkthrough's expected output.

You need
  any Python 3 from the release's environments (standard library only). A missing tool is reported as "not found", never as a failure.

What it does
  1. reads the repository's path, git commit and uncommitted files
  2. reads this Python's version, and torch (CUDA, cuDNN, the GPUs it sees) and numpy when they can be imported; the GPUs and the driver (nvidia-smi)
  3. finds the external programs as the pipeline finds them (linc/construction/tools.py), beside the versions the paper used (configs/mri_construction.yaml
     `tools`): FSL ($FSLDIR/etc/fslversion), MMORF ($MMORF or `mmorf` on PATH), ANTs ($ANTSPATH or PATH), MRtrix3 ($MRTRIX or PATH), and zarr2nii (on PATH in
     env/tirl.yml; ZARR2NII_BIN when set)
  4. asks each interpreter the pipeline is pointed at for its own versions (Python, torch, CUDA, MONAI, TIRL, anatomix): LINC_SEGMENT_PYTHON, ANATOMIX_PYTHON,
     PY_TIRL, PY_MRI, PY_DEEP (env/README.md says which environment each one is)
  5. lists the roots (CONVENTIONS.md: LINC_RAW, LINC_DATA, LINC_TEMPLATE, LINC_MODELS, LINC_PRODUCTS, LINC_NUMBERS, LINC_WORK), set or not, and every other $LINC_* setting

You get
  a report on the terminal, or JSON with --json; nothing is written. A few seconds, up to about a minute when an interpreter imports torch for the first time from a
  network disk.

    cli/linc-info [--json]
"""
import argparse
import json
import os
import platform
import re
import shutil
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]
ROOTS = ("LINC_RAW", "LINC_DATA", "LINC_TEMPLATE", "LINC_MODELS", "LINC_PRODUCTS", "LINC_NUMBERS", "LINC_WORK")
INTERPRETERS = ("LINC_SEGMENT_PYTHON", "ANATOMIX_PYTHON", "PY_TIRL", "PY_MRI", "PY_DEEP")
NOT_FOUND = "not found"
PROBE = r"""
import json, sys
out = {"python": sys.version.split()[0]}
for name, mod in (("torch", "torch"), ("monai", "monai"), ("numpy", "numpy"), ("tirl", "tirl"), ("anatomix", "anatomix"),
                  ("fireants", "fireants"), ("SimpleITK", "SimpleITK")):
    try:
        m = __import__(mod)
        out[name] = getattr(m, "__version__", "installed")
        if mod == "torch":
            out["cuda"] = m.version.cuda
    except Exception:
        pass
print(json.dumps(out))
"""


def run(cmd, timeout=60):
    """stdout + stderr of a command, or None when it is missing, fails to start or times out"""
    try:
        r = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, universal_newlines=True, timeout=timeout)  # python >= 3.5
        return (r.stdout or "") + (r.stderr or "")
    except (OSError, subprocess.SubprocessError):
        return None


def versions_of_record():
    """configs/mri_construction.yaml `tools: {fsl: "...", ...}`, read without a YAML library"""
    try:
        line = next(x for x in (REPO / "configs" / "mri_construction.yaml").read_text().splitlines() if x.startswith("tools:"))
        return dict(re.findall(r'(\w+):\s*"([^"]+)"', line))
    except (OSError, StopIteration):
        return {}


def program(name, env_dir):
    """as linc/construction/tools.py finds it: $<env_dir>/<name>, else PATH"""
    d = os.environ.get(env_dir)
    if d and (Path(d) / name).exists():
        return str(Path(d) / name)
    return shutil.which(name)


def external():
    out = {}
    fsl = os.environ.get("FSLDIR")
    v = None
    if fsl and (Path(fsl) / "etc" / "fslversion").exists():
        v = (Path(fsl) / "etc" / "fslversion").read_text().split(":")[0].strip()
    out["fsl"] = dict(version=v or NOT_FOUND, path=fsl or "(FSLDIR not set)")
    p = os.environ.get("MMORF") or shutil.which("mmorf")
    txt = run([p, "--version"]) if p else None
    out["mmorf"] = dict(version=(txt.split("version", 1)[1].split()[0].lstrip("v") if txt and "version" in txt else NOT_FOUND),
                        path=p or "(MMORF not set, mmorf not on PATH)")
    p = program("antsRegistration", "ANTSPATH")
    txt = run([p, "--version"]) if p else None
    out["ants"] = dict(version=(txt.split("Version:")[1].split()[0] if txt and "Version:" in txt else NOT_FOUND), path=p or NOT_FOUND)
    p = program("mrinfo", "MRTRIX")
    txt = run([p, "-version"]) if p else None
    out["mrtrix"] = dict(version=(txt.split("mrinfo", 1)[1].split()[0] if txt and "mrinfo" in txt else NOT_FOUND), path=p or NOT_FOUND)
    rec = versions_of_record()
    for k, d in out.items():
        d["paper"] = rec.get(k, "")
    return out


def this_python():
    out = dict(python=sys.version.split()[0], executable=sys.executable, platform=platform.platform())
    try:
        import numpy
        out["numpy"] = numpy.__version__
    except ImportError:
        pass
    try:
        import torch
        out.update(torch=torch.__version__, cuda=torch.version.cuda,
                   cudnn=torch.backends.cudnn.version() if torch.backends.cudnn.is_available() else None,
                   gpus_seen=[torch.cuda.get_device_name(i) for i in range(torch.cuda.device_count())] if torch.cuda.is_available() else [])
    except ImportError:
        out["torch"] = "not in this environment"
    return out


def gpus():
    txt = run(["nvidia-smi", "--query-gpu=index,name,memory.total,driver_version", "--format=csv,noheader"], timeout=20)
    if not txt or "," not in txt:
        return NOT_FOUND
    return [x.strip() for x in txt.strip().splitlines()]


def interpreters():
    out = {}
    for var in INTERPRETERS:
        p = os.environ.get(var) or (os.environ.get("PY_COMPLETION") if var == "PY_DEEP" else None)
        if not p:
            out[var] = "(not set)"; continue
        txt = run([p, "-c", PROBE], timeout=120)
        try:
            out[var] = dict(path=p, **json.loads(txt.strip().splitlines()[-1]))
        except (AttributeError, ValueError, IndexError):
            out[var] = dict(path=p, error=NOT_FOUND if txt is None else "did not run: " + (txt or "").strip()[-200:])
    p = os.environ.get("ZARR2NII_BIN") or shutil.which("zarr2nii")          # env/tirl.yml puts it on PATH; ZARR2NII_BIN still honored
    out["zarr2nii"] = dict(path=p, via="ZARR2NII_BIN" if os.environ.get("ZARR2NII_BIN") else "PATH") if p else NOT_FOUND
    return out


def roots():
    """the folder roots (CONVENTIONS.md): set or not, and whether the folder exists"""
    return {k: (dict(path=os.environ[k], exists=Path(os.environ[k]).is_dir()) if os.environ.get(k) else "(not set)") for k in ROOTS}


def settings():
    """every other $LINC_* variable that is set (LINC_SEGMENT_DEVICE, LINC_SKIP_VERSION_CHECK, ...)"""
    return {k: v for k, v in sorted(os.environ.items()) if k.startswith("LINC_") and k not in ROOTS and k not in INTERPRETERS}


def repo():
    commit = run(["git", "-C", str(REPO), "rev-parse", "--short", "HEAD"], timeout=20)
    status = run(["git", "-C", str(REPO), "status", "--porcelain"], timeout=20)
    return dict(path=str(REPO), commit=commit.strip() if commit and "fatal" not in commit else NOT_FOUND,
                uncommitted_files=len(status.splitlines()) if status is not None and "fatal" not in status else None)


def show(d, ind=0):
    for k, v in d.items():
        if isinstance(v, dict):
            print(" " * ind + f"{k}:"); show(v, ind + 2)
        elif isinstance(v, list):
            print(" " * ind + f"{k}: " + ("none" if not v else "")); [print(" " * (ind + 2) + f"- {x}") for x in v]
        else:
            print(" " * ind + f"{k}: {v}")


def main():
    ap = argparse.ArgumentParser(prog="linc-info", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--json", action="store_true", help="one JSON object instead of the text")
    a = ap.parse_args()
    info = dict(repository=repo(), this_python=this_python(), gpus=gpus(), external_programs=external(),
                interpreters=interpreters(), roots=roots(), settings=settings() or "(none set)")
    if a.json:
        print(json.dumps(info, indent=1))
    else:
        show(info)


if __name__ == "__main__":
    main()
