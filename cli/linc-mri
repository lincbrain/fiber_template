#!/usr/bin/env python3
"""Prepare a new brain's MRI for registration to the template.

You need
  one MRI image of the brain as NIfTI: a b0 (or a T2-weighted image with --modality t2), 3-D or a 4-D series (--volume N picks one);
  optionally its brain mask on the same grid (--mask; else the MRI brain-mask network under $LINC_MODELS makes one);
  ANTs (ANTSPATH) for N4; for the network, $LINC_SEGMENT_PYTHON (env/deep.yml) and, by default, a GPU.

What it does
  1. stages the image under its own header (nothing is resampled);
  2. denoises it, only with --denoise (ANTs DenoiseImage; the paper's images were denoised by the scanner-side pipeline);
  3. takes the given mask or predicts one;
  4. corrects the intensity bias inside the mask (ANTs N4, the paper's parameters; --no-n4 skips it);
  5. masks the image and rescales its 1-99 percentile range to (0, 4095].

You get, in $M = $LINC_DATA/sub-<ID>/mri (or --mri-root)
  b0: $M/dwi/b0.nii.gz, $M/masks/dwi_brain_mask.nii.gz (+ .json when predicted), $M/dwi/b0_brain.nii.gz,
      $M/dwi/b0_brain_n4.nii.gz (+ _bias) and $M/dwi/b0_brain_n4.provenance.json
  t2: $M/t2/echo.nii.gz, $M/masks/t2_brain_mask.nii.gz, $M/t2/echo_n4.nii.gz (+ _bias), $M/t2/echo_n4_brain.nii.gz (+ .provenance.json)
  and the next command, printed at the end:
      cli/linc-register mri --subject <ID> --place-b0 $M/dwi/b0_brain_n4.nii.gz $M/masks/dwi_brain_mask.nii.gz --new-brain

    linc-mri prep --subject <ID> --image <NIfTI> [--modality b0|t2] [--mask MASK] [--volume N] [--denoise] [--no-n4]
                  [--mri-root DIR] [--device cuda|cpu]

Environment: env/linc.yml. Code: linc/construction/mri_new_brain.py (paper: Methods, "MRI preprocessing").
"""
import argparse
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPO))


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = ap.add_subparsers(dest="cmd", required=True)
    p = sp.add_parser("prep", help="a new brain's b0 or T2-weighted image -> its masked, bias-corrected image and brain mask")
    p.add_argument("--subject", required=True, help="the brain's identifier (file names, $LINC_DATA/sub-<ID>)")
    p.add_argument("--image", required=True, help="the b0 or T2-weighted NIfTI (3-D, or a 4-D series with --volume)")
    p.add_argument("--modality", choices=("b0", "t2"), default="b0")
    p.add_argument("--mask", default=None, help="a brain mask on the image's grid (0/1); without it the MRI brain-mask network runs")
    p.add_argument("--volume", type=int, default=0, help="the volume of a 4-D series to take (default 0, the b0 of a diffusion series)")
    p.add_argument("--denoise", action="store_true", help="ANTs DenoiseImage (Rician) first; skipped with a message when ANTs is absent")
    p.add_argument("--no-n4", action="store_true", help="no bias correction")
    p.add_argument("--mri-root", default=None, help="write here instead of $LINC_DATA/sub-<ID>/mri")
    p.add_argument("--device", default="cuda", help="the mask network's device (cuda, cuda:N, cpu)")
    a = ap.parse_args()
    from linc.construction import mri_new_brain
    print(f"linc-mri prep {a.subject} ({a.modality})")
    mri_new_brain.prep(a.subject, a.image, a.modality, mask=a.mask, volume=a.volume, denoise=a.denoise, n4=not a.no_n4,
                       mri_root=a.mri_root, device=a.device)


if __name__ == "__main__":
    main()
