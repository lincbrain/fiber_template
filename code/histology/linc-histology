#!/usr/bin/env python3
"""Register a brain's histology sections to its blockface photographs, so their labels can be transformed to the template
(Methods, "Histology registration and label propagation").

You need
  the brain's reconstruction (<ID>_blockface.ome.zarr, code/blockface/linc-reconstruct); its histology sections (the Haber laboratory's
  collection: JPEG 2000, *nDF.jp2; LINC dataset 000003, sourcedata/sub-<ID>/micr); the regions volume on the blockface (1 left, 2 right,
  3 cerebellum + brainstem, 4 marker tubes; how to make one: code/histology/README.md); settings/brains/<ID>.yaml (idx_range,
  ccs / cce); settings/env/tirl.yml's Python ($PY_TIRL) with TIRL. The match table (section number -> photograph number per component; format
  in code/histology/match.py) is, in this order: --table; <histology folder>/match_table_edited.txt, a copy of the proposal changed
  by hand, which nothing overwrites; <histology folder>/match_table.txt; <histology folder>/match_table_proposed.txt. The histology
  folder is the parent of --out.
What it does (`all` runs the steps in order, after `propose` when there is no table; each can be run alone, and a run resumes where
it stopped)
  propose   a proposed match table, to review row by row (code/histology/propose.py; needs the brain mask, <ID>_mask.nii.gz beside the
            store, or --brain-mask; reads JPEG 2000 files, or a stack: --histology <stack>.ome.zarr --section-map <tsv>; match and the
            later steps read JPEG 2000 only)
  match     each section's blockface photograph
  pieces    each photograph split into the section's components (hemispheres, cerebellum and brainstem: the regions volume)
  masks     each histology component's tissue mask
  prepare   TIRL's moving (histology) and fixed (blockface) images
  register  each component registered with TIRL (the registration library): rotation, rigid, affine, nonlinear (12 threads per
            component reproduce the paper's)
  rgb       the registered sections in color
You get
  in --out (write it to $LINC_DATA/sub-<ID>/histology/registration, where the label steps read it): matched/, partition/, pieces/,
  tissue_masks/, moving/, fixed/ (PNG) and tirl/<component>/ (TIRL's transforms, .timg, and the registered images, PNG), each step
  with a provenance.json. propose writes beside --out: match_table_proposed.txt, match_review.csv and match_review/ (an image per
  flagged component).

    $PY_TIRL code/histology/linc-histology all --subject <ID> --store <ID>_blockface.ome.zarr --histology <sections dir> \
        --regions <ID>_regions.nii.gz --out $LINC_DATA/sub-<ID>/histology/registration --threads 12 --jobs 2

Details. Parameters: settings/histology.yaml. The regions volume is scaled into the store's calibrated frame by the brain's own
factors (calibrated / made-at spacing per axis): the made-at spacing is settings/histology.yaml regions.made_at_spacing_um's entry for
--subject (a brain not listed: factor 1), or --regions-spacing-um VX VZ for another volume (a volume made on the brain's current
frame: its vx vz; MF8's registration of record with the tubes filled by inpainting: settings/internal/products_blockface.yaml
hidden_arm_regions, 23.75 600). --idx0 / --ccs / --cce override
the yaml's values. --jobs N registers N components at a time (12 N cores). propose takes photographs per section from
settings/histology.yaml propose.section_um over the section step the volume was built at; --photos-per-section sets it where the
series was cut at another spacing (--jobs N: N cores).
"""
import argparse
import os
import sys
import time
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(REPO / "code"))

from shared import provenance  # noqa: E402
from histology import match, pieces, propose, register, sections  # noqa: E402

STEPS = ["match", "pieces", "masks", "prepare", "register", "rgb"]


def subject_cfg(a):
    import yaml
    f = REPO / "settings" / "brains" / f"{a.subject}.yaml" if a.subject else None
    return (yaml.safe_load(f.read_text()) or {}) if f is not None and f.exists() else {}


def subject_values(a):
    import yaml
    s = {}
    if a.subject:
        f = REPO / "settings" / "brains" / f"{a.subject}.yaml"
        if f.exists():
            s = yaml.safe_load(f.read_text()) or {}
    idx0 = a.idx0 if a.idx0 is not None else (s.get("idx_range") or [None])[0]
    ccs = a.ccs if a.ccs is not None else s.get("ccs", 0)
    cce = a.cce if a.cce is not None else s.get("cce", 0)
    return idx0, int(ccs or 0), int(cce or 0)


def need(a, *names):
    miss = [n for n in names if getattr(a, n) in (None, "")]
    if miss:
        sys.exit(f"this step needs --{' --'.join(m.replace('_', '-') for m in miss)}")


def regions_scale(a, cfg):
    """(made-at spacing, world scale into the store's frame) of the regions volume (pieces.regions_scale)."""
    sc_ = subject_cfg(a)
    made = ({"vx": a.regions_spacing_um[0], "vz": a.regions_spacing_um[1]} if a.regions_spacing_um
            else (cfg["regions"].get("made_at_spacing_um") or {}).get(a.subject))
    if made and not sc_:
        sys.exit("--regions-spacing-um needs --subject (settings/brains/<ID>.yaml: vx, vz)")
    return made, pieces.regions_scale(sc_, made) if sc_ else None          # no --subject: the regions are on the store's frame


def stamp(product, inputs, t0, **extra):
    provenance.write_provenance(product, inputs=[str(p) for p in inputs if p], wall_s=round(time.time() - t0, 1), md5=True,
                                extra=extra)


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("step", choices=["propose"] + STEPS + ["all"])
    ap.add_argument("--subject", help="LINC identifier (reads settings/brains/<ID>.yaml for idx_range and ccs/cce)")
    ap.add_argument("--store", help="the blockface reconstruction, <ID>_blockface.ome.zarr")
    ap.add_argument("--histology", help="folder of the histology sections (JPEG 2000); propose also reads an OME-Zarr stack")
    ap.add_argument("--section-map", help="propose, from an OME-Zarr stack: its section map (stack index -> section number)")
    ap.add_argument("--table", help="the histology <-> blockface match table (default: the edited table, else the proposal)")
    ap.add_argument("--brain-mask", help="propose: the brain mask (default: <ID>_mask.nii.gz beside the store)")
    ap.add_argument("--photos-per-section", type=float, help="propose: photographs per histology section (default: from the spacing)")
    ap.add_argument("--regions", help="atlas regions on the blockface (1 left, 2 right, 3 cerebellum + brainstem, 4 holes)")
    ap.add_argument("--regions-spacing-um", nargs=2, type=float, metavar=("VX", "VZ"),
                    help="the spacing (um) these regions were made at, in place of settings/histology.yaml's for this brain (e.g. "
                         "MF8's hidden-arm regions of record, 23.75 600: settings/internal/products_blockface.yaml hidden_arm_regions)")
    ap.add_argument("--out", required=True, help="output folder of this brain's histology registration")
    ap.add_argument("--masks", help="use these tissue masks instead of <out>/tissue_masks")
    ap.add_argument("--idx0", type=int, help="raw photograph index of the store's first slice")
    ap.add_argument("--ccs", type=int, help="first histology section where the corpus callosum joins the hemispheres")
    ap.add_argument("--cce", type=int, help="last such section")
    ap.add_argument("--whole-from-table", choices=["auto", "yes", "no"], default="auto",
                    help="keep whole-section rows whole (auto: when ccs = cce = 0)")
    ap.add_argument("--pattern", help="section file pattern (default: settings/histology.yaml section_glob)")
    ap.add_argument("--jobs", type=int, default=1, help="parallel processes (masks, TIRL pieces, RGB)")
    ap.add_argument("--threads", type=int, help="threads per TIRL piece (default: settings/histology.yaml tirl.threads)")
    ap.add_argument("--tirl", help="the tirl executable (default: `tirl` on PATH)")
    ap.add_argument("--pieces", nargs="*", help="register only these pieces")
    ap.add_argument("--config", help="parameters (default: settings/histology.yaml)")
    a = ap.parse_args()

    cfg = match.config(a.config)
    out = Path(a.out)
    D = {k: out / k for k in ("matched", "partition", "pieces", "tissue_masks", "moving", "fixed", "tirl")}
    masks_dir = Path(a.masks) if a.masks else D["tissue_masks"]
    idx0, ccs, cce = subject_values(a)
    wft = None if a.whole_from_table == "auto" else a.whole_from_table == "yes"
    histology_dir = out.parent
    steps = STEPS if a.step == "all" else [a.step]
    if a.step == "all" and not match.find_table(histology_dir, a.table)[0]:
        steps = ["propose"] + STEPS
    cfg_file = a.config or str(match.CONFIG)
    table_said = False

    for step in steps:
        t0 = t_step = time.time()
        print(f"=== {time.strftime('%F %T')} {step}", flush=True)
        if step != "propose" and not table_said:
            a.table, said = match.find_table(histology_dir, a.table)
            table_said = bool(said)
            if said and step in ("match", "pieces", "masks", "prepare"):
                print(f"match table: {said}", flush=True)
        if step == "propose":
            need(a, "store", "histology", "regions")
            if idx0 is None:
                sys.exit("propose needs --idx0 or --subject")
            sc_ = subject_cfg(a)
            if not sc_ and not a.photos_per_section:
                sys.exit("propose needs --subject (settings/brains/<ID>.yaml) or --photos-per-section")
            a0 = a.photos_per_section or propose.photos_per_section(sc_, cfg)
            vx = float((sc_.get("reconstruction_spacing_um") or sc_)["vx"])
            _, sc = regions_scale(a, cfg)
            mask = a.brain_mask or str(Path(a.store).parent / f"{a.subject}_mask.nii.gz")
            secs = (sections.sections(stack=a.histology, section_map=a.section_map) if a.histology.rstrip("/").endswith(".zarr")
                    else sections.sections(jp2_dir=a.histology))
            summ, _ = propose.propose(a.store, mask, a.regions, secs, idx0, histology_dir, a0, vx, sc, a.jobs, cfg)
            stamp(histology_dir / propose.PROPOSED, [a.store, mask, a.regions, a.histology, a.section_map, cfg_file], t0, idx0=idx0, **summ)
        elif step == "match":
            need(a, "store", "histology", "table")
            if idx0 is None:
                sys.exit("match needs --idx0 or --subject")
            match.match_photos(a.store, a.histology, a.table, idx0, D["matched"], cfg, a.pattern)
            stamp(D["matched"], [a.store, a.histology, a.table, cfg_file], t0, idx0=idx0)
        elif step == "pieces":
            need(a, "store", "table", "regions")
            if idx0 is None:
                sys.exit("pieces needs --idx0 or --subject")
            made, sc = regions_scale(a, cfg)
            pieces.partition(D["matched"], a.regions, a.store, a.table, idx0, D["partition"], cfg, scale_xyz=sc)
            stamp(D["partition"], [D["matched"], a.regions, a.store, a.table, cfg_file], t0, idx0=idx0, regions_made_at_um=made,
                  regions_scale=list(sc) if sc else None)
            t0 = time.time()
            pieces.cut_pieces(D["matched"], D["partition"], a.table, ccs, cce, D["pieces"], wft, cfg)
            stamp(D["pieces"], [D["matched"], D["partition"], a.table, cfg_file], t0, ccs=ccs, cce=cce,
                  whole_from_table=a.whole_from_table)
        elif step == "masks":
            need(a, "histology", "table")
            register.tissue_masks(a.histology, a.table, masks_dir, a.jobs, a.config, a.pattern)
            stamp(masks_dir, [a.histology, a.table, cfg_file], t0)
        elif step == "prepare":
            need(a, "histology")
            if not masks_dir.is_dir():
                need(a, "table")
                register.tissue_masks(a.histology, a.table, masks_dir, a.jobs, a.config, a.pattern)
                stamp(masks_dir, [a.histology, a.table, cfg_file], t0)
            t0 = time.time()
            register.moving_images(a.histology, masks_dir, D["pieces"], D["moving"], cfg, a.pattern)
            stamp(D["moving"], [a.histology, masks_dir, D["pieces"], cfg_file], t0)
            t0 = time.time()
            register.fixed_images(D["pieces"], D["fixed"], cfg)
            stamp(D["fixed"], [D["pieces"], cfg_file], t0)
        elif step == "register":
            res = register.run_tirl(D["moving"], D["fixed"], D["tirl"], a.jobs, a.threads, a.tirl, a.pieces, cfg)
            stamp(D["tirl"], [D["moving"], D["fixed"], cfg_file], t0, pieces_run=res)
            if any(not r["ok"] for r in res.values()):
                sys.exit(1)
        elif step == "rgb":
            need(a, "histology")
            py = register.tirl_python(a.tirl, cfg)
            bad = register.registered_rgb(a.histology, masks_dir, D["pieces"], D["moving"], D["tirl"], a.jobs, py, a.config)
            if bad:
                sys.exit(1)
        print(f"=== {step} done in {time.time() - t_step:.0f} s", flush=True)


if __name__ == "__main__":
    main()
