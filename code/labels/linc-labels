#!/usr/bin/env python3
"""Transform the histology labels to the MRI template: register them onto the blockface, interpolate them between sections,
and resample them into the template, so that labels drawn on sections can be read in template space.

You need, per brain under $LINC_DATA/sub-<ID>/ (settings/labels.yaml `layout`)
  histology/annotations/<class>.ome.zarr (the annotators' masks), histology/section_map.tsv, the match table (code/histology/match.py),
  histology/regions.nii.gz (the atlas regions: left, right, cerebellum), the histology registration under histology/registration/
  (linc-histology), the blockface grid blockface/<ID>_blockface_L2.nii.gz, and for `carry` the registry entries to the template.

What it does
  push         moves each class through each piece's histology -> blockface registration onto its blockface slice (TIRL);
  interpolate  fills the slices between charted sections: the bundle grades as one group and the terminal grades as one, each density
               class kept as a part of its group, sections paired within each hemisphere, demons between each pair (SimpleITK);
  carry        resamples the labels once into the MRI template (anti-aliased, linear), through the registry's transforms or given ones;
  connect      joins the carried bundle label into one connected pathway, marking the joins as inferred (code/labels/connect.py);
  all          push, interpolate, carry and connect in turn.

You get, under $LINC_DATA/sub-<ID>/labels/
  blockface/tracer/<ID>_<class>_bfnative_L2.nii.gz (+ push_tracer_<ID>.json)                              push
  blockface/tracer/<ID>_<group or class>_bfnative_L2_demons.nii.gz, <ID>_labels_demons_prov.nii.gz, interp_v2.json   interpolate
  template/tracer/<ID>_<label>_mri-template{,_density,_footprint}.nii.gz + tracer_template_<ID>.json        carry
  template/tracer/<ID>_<group>_mri-template_solid2.nii.gz, <ID>_Bundles_mri-template_{connected,solid_v2c,bridges}.nii.gz, <ID>_connect_v2c.json   connect
  (density: float 0-1; solid and footprint: uint8 {0, 1}; provenance: 1 = charted section, 2 = interpolated; connected: 1 = charted, 2 = inferred)

    linc-labels push        --subject MR252 [--kind tracer|structures]
    linc-labels interpolate --subject MR252 [--method v2|v1]
    linc-labels carry       --subject MR252 [--entry DIR ...]
    linc-labels carry       --subject MR243 --kind structures [--dense] [--route blockface|mri]
    linc-labels connect     --subject MR252
    linc-labels all         --subject MR252
Every path can be overridden. The transforms of `carry`, in PULL order (a template point goes first to last):
  --entry DIR [--entry DIR ...]     registry entries (shared.xfm), each '<dir>' or '<dir>:inv', in IMAGE order (bf-native first)
  --map DIR:NAME / --warp FILE:CONV[:SRC_GRID] / --ras-pull FILE     a precomputed pull map, in PULL order (template first)
  (neither: the brain's route, settings/labels.yaml template_routes, or --route: blockface, through the blockface template as the paper
  carries the labels (a brain outside the paper through its step-9 refined entry, xfm_step9/; code/labels/route.py), or mri, through
  its R1 of record and its b0's registration to the template; a brain not in template_routes takes the blockface route).
`carry --kind structures` carries the LGN and STN (code/labels/structures.py): from labels/blockface/structures/ (or --labels-dir) to
labels/template/structures/, into the MRI template on the brain's route (settings/labels.yaml template_routes, or --route) and into
its b0 through its R1 of record; --dense takes the demons-interpolated labels (*_bfnative_L2_demons).
Environments: push in settings/env/tirl.yml, interpolate and carry in settings/env/linc.yml (paper: Methods, "Histology registration and label propagation").
"""
import argparse
import os
import sys
import time
from glob import glob
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "code"))
from shared import paths, provenance  # noqa: E402
from labels import labels as LB
from histology import match  # noqa: E402


def _table(a, L):
    """The match table: --match-table, else the order every step uses (match.find_table). None found: the layout's path, whose read says so."""
    table, said = match.find_table(Path(L("match_table")).parent, a.match_table)
    if said:
        print(f"match table: {said}", flush=True)
    return table or L("match_table")


def _p(v, default):
    return Path(v) if v else default


def cmd_push(a, cfg):
    S = a.subject
    L = lambda k: LB.layout(S, k, cfg)  # noqa: E731
    grid = _p(a.grid, L("grid"))
    reg = _p(a.registrations, L("registrations"))
    mt = _table(a, L)
    i0 = a.first_photo if a.first_photo is not None else LB.first_photo(S)
    t0 = time.time()
    if a.kind == "tracer":
        out = _p(a.out, L("labels") / "blockface" / "tracer")
        ann, smap = _p(a.annotations, L("annotations")), _p(a.section_map, L("section_map"))
        pm, bp = _p(a.piece_masks, L("piece_masks")), _p(a.blockface_pieces, L("blockface_pieces"))
        rec, outs = LB.push_tracer(S, annotations_dir=ann, section_map=smap, match_table_path=mt, piece_masks=pm, blockface_pieces=bp,
                                   registrations=reg, grid=grid, first_photo_number=i0, out_dir=out, cfg=cfg)
        ins = [smap, mt, grid]
    else:
        out = _p(a.out, L("labels") / "blockface" / "structures")
        sd, mv = _p(a.structures, L("structures")), _p(a.moving, L("moving"))
        structs = cfg["push"]["structures"]
        items, alog = LB.structures_stage_a(S, sd, mv, structs)
        rec, outs = LB.push_structures(S, items, match_table_path=mt, registrations=reg, grid=grid, first_photo_number=i0, out_dir=out,
                                       structs=structs, cfg=cfg)
        rec["stage_a"] = alog
        ins = [mt, grid, sd / "frame_map.json"]
    if not outs:
        raise SystemExit(f"{S}: nothing pushed, nothing written ({a.kind}): no label reached the blockface grid.")
    for f in outs:
        provenance.write_provenance(f, inputs=ins, wall_s=round(time.time() - t0, 1), extra=dict(stage="push", kind=a.kind), md5=False)
    return outs


def cmd_interpolate(a, cfg):
    from labels import interpolate as IP
    S = a.subject
    L = lambda k: LB.layout(S, k, cfg)  # noqa: E731
    lab = a.labels or sorted(glob(str(L("labels") / "blockface" / "*" / f"{S}_*_bfnative_L2.nii.gz")))
    if not lab:
        raise SystemExit(f"{S}: nothing to interpolate: no {S}_*_bfnative_L2.nii.gz under {L('labels') / 'blockface'}. Run `linc-labels push` first.")
    out_for = (lambda p: a.out) if a.out else None
    t0 = time.time()
    method = getattr(a, "method", None) or cfg["interpolate"].get("method", "v2")
    if method == "v2":
        import yaml
        from histology import pieces
        regions = _p(getattr(a, "regions", None), L("regions"))
        hcfg = yaml.safe_load((Path(LB.CONFIG).parent / "histology.yaml").read_text())
        made = ({"vx": a.regions_spacing_um[0], "vz": a.regions_spacing_um[1]} if getattr(a, "regions_spacing_um", None)
                else (hcfg["regions"].get("made_at_spacing_um") or {}).get(S))          # as linc-histology: no entry -> factor 1
        scale = pieces.regions_scale(LB.subject_config(S), made)
        out = _p(a.out, L("labels") / "blockface" / "tracer")
        rec, outs = IP.interpolate_v2(S, registrations=_p(a.registrations, L("registrations")), match_table_path=_table(a, L),
                                      first_photo_number=a.first_photo if a.first_photo is not None else LB.first_photo(S),
                                      grid=_p(a.grid, L("grid")), label_files=lab, regions=regions, regions_scale=scale, out_dir=out, cfg=cfg)
        for f in outs:
            provenance.write_provenance(f, inputs=lab + [regions], wall_s=round(time.time() - t0, 1), extra=dict(stage="interpolate", method="v2", regions_scale=scale), md5=False)
        return outs
    rec, outs = IP.interpolate(S, registrations=_p(a.registrations, L("registrations")), match_table_path=_table(a, L),
                               first_photo_number=a.first_photo if a.first_photo is not None else LB.first_photo(S),
                               grid=_p(a.grid, L("grid")), label_files=lab, interp_dir=_p(a.interp_dir, L("interp")), out_for=out_for, cfg=cfg)
    for f in outs:
        provenance.write_provenance(f, inputs=lab, wall_s=round(time.time() - t0, 1), extra=dict(stage="interpolate", method="v1"), md5=False)
    return outs


def cmd_carry_structures(a, cfg):
    from labels import route as RT
    from labels import structures as STR
    S = a.subject
    L = lambda k: LB.layout(S, k, cfg)  # noqa: E731
    src = _p(a.labels_dir, L("labels") / "blockface" / "structures")
    out = _p(a.out, L("labels") / "template" / "structures")
    route = a.route or RT.route_of(S)
    t0 = time.time()
    rec = STR.carry_structures(S, src, out, STR.targets_for(S, route), cfg["push"]["structures"], a.dense)
    print(f"{S}: {len(rec)} structures carried on the {route} route ({'dense' if a.dense else 'plain'}) in {time.time() - t0:.0f} s -> {out}")


def cmd_carry(a, cfg):
    from shared import xfm
    from labels import carry as CA
    S = a.subject
    if getattr(a, "kind", "tracer") == "structures":
        return cmd_carry_structures(a, cfg)
    L = lambda k: LB.layout(S, k, cfg)  # noqa: E731
    C = cfg["carry"]
    ref = Path(a.ref) if a.ref else paths.template_root() / C["ref"]
    brain = Path(a.brain) if a.brain else paths.template_root() / C["brain"]
    lab = a.labels or sorted(glob(str(L("labels") / "blockface" / "tracer" / f"{S}_*_bfnative_L2_demons.nii.gz")))
    if not lab:
        raise SystemExit(f"{S}: nothing to carry: no {S}_*_bfnative_L2_demons.nii.gz under {L('labels') / 'blockface' / 'tracer'}. Run `linc-labels interpolate` first.")
    out = _p(a.out, L("labels") / "template" / "tracer")
    chain = pull = desc = None
    steps = []
    for m in a.map or []:
        d, n = m.rsplit(":", 1); steps.append(("map", d, n))
    for w in a.warp or []:
        steps.append(("warp",) + tuple(w.split(":")))
    for r in a.ras_pull or []:
        steps.append(("ras_pull", r))
    if steps:
        if a.entry:
            raise SystemExit("give --entry (registry chain) or --map/--warp/--ras-pull (pull route), not both")
        pull, desc = CA.pull_steps(steps)
    elif a.entry:
        links = []
        for e in a.entry:
            inv = e.endswith(":inv")
            ent = xfm.Entry(e[:-4] if inv else e)
            links.append(xfm.InverseEntry(ent) if inv else ent)
        chain = xfm.Chain(links, strict=True)
    else:                                                     # the brain's route (code/labels/route.py)
        from labels import route as RT
        route = a.route or RT.route_of(S)
        if route == "blockface":
            PF = paths.products("products_figures")
            rc = RT.RouteChain(S, PF)
            if RT.uses_pull(S, PF):
                pull, desc = rc.pull, rc.describe()
            else:
                chain = rc
        else:
            chain = RT.template_chain(S, "mri")
        print(f"{S}: the {route} route", flush=True)
    t0 = time.time()
    rec, outs = CA.carry(S, lab, ref=ref, brain=brain, out_dir=out, chain=chain, pull=pull, links=desc, cfg=cfg)
    for f in outs:
        provenance.write_provenance(f, inputs=lab + [ref], wall_s=round(time.time() - t0, 1),
                                    extra=dict(stage="carry", route=rec["links"]), md5=False)
    return outs


def cmd_connect(a, cfg):
    from labels import connect as CO
    S = a.subject
    d = _p(a.labels_dir, LB.layout(S, "labels", cfg) / "template" / "tracer")
    t0 = time.time()
    CO.write_solids(S, d)
    rec = CO.connect(S, d, paths.template_root() / "mri", _p(a.out, d))
    print(f"{S}: {rec['final']['pieces_attached']} components joined, {100 * rec['final']['inferred_share']:.1f} % of the pathway inferred; {time.time() - t0:.0f} s")


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--subject", required=True, help="LINC identifier, e.g. MR252")
    common.add_argument("--grid", help="target blockface grid (default: layout grid)")
    common.add_argument("--registrations", help="per-piece registration folders (default: layout registrations)")
    common.add_argument("--match-table", help="section -> photograph table (default: the brain's, in the order of code/histology/match.py find_table)")
    common.add_argument("--first-photo", type=int, help="photograph number of blockface slice 0 (default: settings/brains/<S>.yaml)")
    common.add_argument("--out", help="output folder")
    p = sub.add_parser("push", parents=[common])
    p.add_argument("--kind", choices=["tracer", "structures"], default="tracer")
    p.add_argument("--annotations"); p.add_argument("--section-map"); p.add_argument("--piece-masks"); p.add_argument("--blockface-pieces")
    p.add_argument("--structures"); p.add_argument("--moving")
    p = sub.add_parser("interpolate", parents=[common])
    p.add_argument("--labels", nargs="*", help="label sheets (default: every *_bfnative_L2.nii.gz under labels/blockface/)")
    p.add_argument("--interp-dir")
    p.add_argument("--method", choices=["v2", "v1"], help="v2 = the interpolation of record since 3 Nov 2026 (groups, per-hemisphere pairing); v1 = per class, with the RGB volume (default: settings/labels.yaml interpolate.method)")
    p.add_argument("--regions", help="v2: the atlas regions volume (default: layout regions)")
    p.add_argument("--regions-spacing-um", nargs=2, type=float, metavar=("VX", "VZ"),
                   help="v2: the spacing (um) the regions were made at, in place of settings/histology.yaml's entry for the brain (a brain "
                        "not listed: factor 1), as in linc-histology")
    for name in ("carry", "all"):
        p = sub.add_parser(name, parents=[common])
        p.add_argument("--labels", nargs="*", help="dense labels (default: labels/blockface/tracer/*_bfnative_L2_demons.nii.gz)")
        p.add_argument("--ref"); p.add_argument("--brain")
        p.add_argument("--entry", action="append"); p.add_argument("--map", action="append")
        p.add_argument("--warp", action="append"); p.add_argument("--ras-pull", action="append")
        if name == "carry":
            p.add_argument("--kind", choices=["tracer", "structures"], default="tracer")
            p.add_argument("--dense", action="store_true", help="structures: the demons-interpolated labels (*_bfnative_L2_demons)")
            p.add_argument("--labels-dir", help="structures: the blockface labels' folder (default: labels/blockface/structures of the brain)")
        p.add_argument("--route", choices=["blockface", "mri"], help="the route into the MRI template when no transform is given (default: settings/labels.yaml template_routes, else blockface)")
        if name == "all":
            p.add_argument("--interp-dir")
            for k in ("annotations", "section_map", "piece_masks", "blockface_pieces"):
                p.add_argument("--" + k.replace("_", "-"))
    p = sub.add_parser("connect", parents=[common])
    p.add_argument("--labels-dir", help="the carried labels' folder (default: labels/template/tracer of the brain)")
    a = ap.parse_args(argv)
    cfg = LB.config()
    if a.cmd == "push":
        cmd_push(a, cfg)
    elif a.cmd == "interpolate":
        cmd_interpolate(a, cfg)
    elif a.cmd == "carry":
        cmd_carry(a, cfg)
    elif a.cmd == "connect":
        cmd_connect(a, cfg)
    else:                                                     # all: default folders between the stages
        out = a.out
        a.out, a.kind = None, "tracer"
        cmd_push(a, cfg)
        a.labels = None
        cmd_interpolate(a, cfg)
        a.labels, a.out = None, out
        cmd_carry(a, cfg)
        a.labels_dir = out
        cmd_connect(a, cfg)


if __name__ == "__main__":
    os.umask(0o002)                                                   # outputs readable by the group
    main()
