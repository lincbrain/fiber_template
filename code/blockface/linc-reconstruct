#!/usr/bin/env python3
"""Reconstruct a brain's blockface photographs into a 3D volume, to which its MRI and histology are then registered (Methods,
"Blockface reconstruction"; Fig. 3).

You need
  the photographs as taken, one JPEG per section, in $LINC_RAW/<raw> (docs/how-to/new_brain.md); the brain's settings/brains/<ID>.yaml (a new
  brain: copy settings/brains/TEMPLATE.yaml): the photographs' folder, pattern and numbering, pixel size and section step, and the
  hand-made lists of camera jumps and missing sections; optional hand corrections (curated/<ID>_mask_edited.nii.gz,
  curated/<ID>_holes_edited.nii.gz, corrected photograph masks in 01_brainmask/01_final); the network weights in $LINC_MODELS/segment;
  settings/env/tirl.yml's Python ($PY_TIRL) with TIRL and zarr2nii beside it, and settings/env/deep.yml's ($LINC_SEGMENT_PYTHON) for the networks.
What it does (`all` runs these steps in order; each can be run alone)
  photos    the photographs renamed in cutting order (00_slices) and segmented by the photograph network (01_brainmask)
  stack     the photographs and their masks stacked into a volume
  prepare   each camera jump registered with TIRL (the registration library) and corrected; masks finalized, missing sections
            filled in, the stack cropped, illumination and brightness corrected
  mask      the 3D brain mask (the network's, or your curated/<ID>_mask_edited)
  volume    the reconstruction: the brain on the reconstruction grid, the marker tubes filled
  tubes     the 3D marker tubes (the network's, or your curated/<ID>_holes_edited)
  spacing   the calibrated pixel size and section step written into the headers
You get
  in $LINC_DATA/sub-<ID>/blockface/: <ID>_blockface.ome.zarr (the reconstruction, OME-Zarr pyramid, RGB), <ID>_mask.nii.gz and
  <ID>_holes.nii.gz (brain mask and marker tubes, NIfTI), <ID>_blockface_L2.nii.gz (a light NIfTI export), <ID>.info, QC images.
  Compare two reconstructions (e.g. yours with the paper's): tests/compare/compare_reconstruction.py.

    $PY_TIRL code/blockface/linc-reconstruct all --subject <ID>
    $PY_TIRL code/blockface/linc-reconstruct <step> --subject <ID>
    $PY_TIRL code/blockface/linc-reconstruct edit-photo-masks export|import --subject <ID>     optional: hand-correct the photograph masks

Details. Hand corrections: after `prepare`, a brain mask edited on curated/<ID>_bg is saved as curated/<ID>_mask_edited.nii.gz;
after `volume`, edited tubes as curated/<ID>_holes_edited.nii.gz (code/blockface/curate.py folds edits made on the final grid back);
settings/brains/<ID>.yaml `masks_of_record` lists which of the paper's masks are hand edits. The networks: settings/blockface.yaml
`segmentation.models` (code/shared/linc-segment); their post-processing is applied once by code/blockface/mask_rules.py. MF8 and MF9 replay their recorded
alignment to an external series in `photos`. Parameters: settings/blockface.yaml; per brain: settings/brains/<ID>.yaml.
"""
import argparse
import os
import shutil
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(REPO / "code"))
from blockface import curate, external, jumps, photos, prepare, reconstruct, segment3d, series, spacing  # noqa: E402
from blockface.subject import Subject, params  # noqa: E402


def step_photos(cfg, a):
    photos.ingest(cfg)
    external.segment(params()["segmentation"]["models"]["photos"], cfg.slices, cfg.brainmask("00_predict"), native=True,
                     postprocess="none")        # the raw masks; normalize_masks applies the fill once
    photos.normalize_masks(cfg)
    photos.finalize_brainmask(cfg)
    sa = cfg.yaml.get("series_alignment")
    if sa:                                      # MF8, MF9: aligned to their external series instead of camera jumps
        series.apply(cfg, os.path.join(cfg.root, sa["align"]), sa["frame_shape_px"])


def step_stack(cfg, a):
    photos.stack_blockface(cfg)
    photos.stack_masks(cfg)


def step_prepare(cfg, a):
    if not a.reuse_jumps:
        jumps.cut_jumps(cfg)
        jumps.tirl_jumps(cfg)
    jumps.register_jumps(cfg)
    prepare.remove_background(cfg)
    prepare.interpolate_missing(cfg)
    prepare.filter_components_3d(cfg, frac=0.10)
    prepare.crop_and_mask(cfg)
    prepare.blockface_bg(cfg)
    prepare.correct_shading(cfg)
    prepare.harmonize_intensity(cfg)
    prepare.export_stage3(cfg)


def _seg3d(cfg, a, which, prep, post):
    """which: "mask" or "tubes": the network's input (prep), the network, its post-processing (post)."""
    inp, out = os.path.join(cfg.seg3d_dir, "in"), os.path.join(cfg.seg3d_dir, "out")
    prep(cfg)
    external.segment(params()["segmentation"]["models"][which], inp, out, postprocess="none")
    post(cfg)
    shutil.rmtree(cfg.seg3d_dir, ignore_errors=True)


def step_mask(cfg, a):
    _seg3d(cfg, a, "mask", segment3d.prep_mask, segment3d.post_mask)


def step_volume(cfg, a):
    reconstruct.reconstruct(cfg)
    if not a.keep_work:                         # the stacks and exports have had their last read
        shutil.rmtree(cfg.work, ignore_errors=True); shutil.rmtree(cfg.nii_dir, ignore_errors=True)


def step_tubes(cfg, a):
    _seg3d(cfg, a, "tubes", segment3d.prep_holes, segment3d.post_holes)
    if os.path.exists(cfg.holes_edited):        # `volume` already filled the hand-edited tubes: re-filling would be identical
        print(f"[tubes] {os.path.basename(cfg.holes_edited)} present: `volume` already filled it; no re-fill")
    else:
        curate.reinpaint(cfg)
    if not a.keep_work:
        shutil.rmtree(cfg.work, ignore_errors=True)


def step_spacing(cfg, a):
    spacing.respace(cfg)


def step_edit(cfg, a):
    {"export": photos.export_for_editing, "import": photos.import_edited_masks}[a.action](cfg)


STEPS = {"photos": step_photos, "stack": step_stack, "prepare": step_prepare, "mask": step_mask, "volume": step_volume,
         "tubes": step_tubes, "spacing": step_spacing}


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = ap.add_subparsers(dest="step", required=True)
    for name in ["all", *STEPS]:
        s = sp.add_parser(name)
        s.add_argument("--subject", required=True)
        if name in ("all", "prepare"):
            s.add_argument("--reuse-jumps", action="store_true", help="reuse _work/tirl_jumps (valid while 00_slices is unchanged)")
        if name in ("all", "volume", "tubes"):
            s.add_argument("--keep-work", action="store_true", help="keep _work/ and nii/ (dropped by default once read)")
    e = sp.add_parser("edit-photo-masks")
    e.add_argument("action", choices=["export", "import"]); e.add_argument("--subject", required=True)
    a = ap.parse_args()
    cfg = Subject(a.subject)
    from shared import paths
    paths.refuse_records(*[d for d, _, _ in os.walk(cfg.root)])    # any folder of the brain holding links to the records: refuse
    if a.step == "edit-photo-masks":
        return step_edit(cfg, a)
    if a.step == "all":
        for name, fn in STEPS.items():
            print(f"=== {a.subject}: {name}", flush=True)
            fn(cfg, a)
        return
    STEPS[a.step](cfg, a)


if __name__ == "__main__":
    main()
