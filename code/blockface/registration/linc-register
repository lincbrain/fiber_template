#!/usr/bin/env python3
"""Register a brain's blockface volume to its own MRI or to the template, and check a registration.

You need
  the brain's reconstruction in $LINC_DATA/sub-<ID>/blockface/ (code/blockface/linc-reconstruct: <ID>_blockface.ome.zarr, <ID>_mask.nii.gz);
  for the MRI-based alignment, the brain's own b0 and its brain mask (mri/; `--place-b0 B0 [MASK]` first registers them rigidly onto
  the template's grid, and with no MASK the MRI brain-mask network makes one); for a brain without MRI, the MRI template's b0 and
  mask ($LINC_TEMPLATE/mri/), its frame and bridge ($LINC_TEMPLATE/frames/, bridge_run113_to_canonical/); settings/env/linc.yml ($PY);
  settings/env/anatomix.yml ($ANATOMIX_PYTHON) and a GPU for the deformable stage (the feature network, anatomix, is downloaded from Hugging
  Face on first use); FSL ($FSLDIR) for the linear stage.
What it does
  mri                 the blockface volume registered to the brain's own b0: a linear start (FLIRT), then a deformable
                      registration (FireANTs) of features computed from both images by a pretrained network (anatomix)
  mri-template        the brain's own b0 registered to the MRI template's b0 (code/template/link/b0_to_template.py; `linc-register
                      mri-template -h`)
  direct-placement    the cross-modal alignment, for a brain without MRI: the blockface volume registered directly to the MRI
                      template's b0; its last stage (CPU) writes what `linc-complete prepare` reads, into mri/stand_in/. On a
                      brain with its own b0 (after `mri`): the same, for training the stand-in network, with the stand-in b0 on
                      that b0's grid
  blockface-template  the blockface-based alignment, the paper's route for a brain without MRI: the blockface volume registered to the
                      blockface template; `python -m shared.xfm chain` then goes through the template's registration to the MRI template,
                      in preference to the cross-modal alignment
  qc                  the paper's acceptance checks of one registration, on the fixed grid: the linear part (scales, rotations, no
                      reflection); the normalized cross-correlation (NCC) between the fixed and moved images inside both brain
                      masks; folds of the warp (negative Jacobian determinants) and its 95th-percentile displacement; the Dice
                      coefficient between the fixed and moved brain envelopes and the distance between their interior edges
                      (reported); the outline check (the distance from the moved brain's outline to the target's, per pole). It
                      writes a three-plane PNG and a JSON row, and with --entry records pass or fail in that entry.
You get
  the transform's registry entry, $LINC_DATA/sub-<ID>/xfm/<src>__to__<dst>/ (meta.json, the warp and the linear transforms, NIfTI
  and text): bf-native__to__b0-native (mri), b0-native__to__mri-template (mri-template), bf-native__to__mri-template
  (direct-placement), bf-native__to__bf-template (blockface-template); `python -m shared.xfm chain|apply` composes and applies them. From direct-placement,
  $LINC_DATA/sub-<ID>/mri/stand_in/; from both, the isotropic pair blockface/<ID>_blockface_iso_grey.nii.gz and <ID>_mask_iso.nii.gz,
  made once if absent. In --out (default $LINC_WORK/register/<ID>), the products on the working grid: the moved blockface, the warp, the measures (JSON). For qc, <out>/<name>.json and .png (default
  $LINC_WORK/qc).

    $PY code/blockface/registration/linc-register mri --subject <ID> [--place-b0 B0 [MASK]] [--new-brain]
    $PY code/blockface/registration/linc-register direct-placement --subject <ID> --template-b0 $LINC_TEMPLATE/mri/linc_mri_b0.nii.gz \
        --template-mask $LINC_TEMPLATE/mri/linc_mri_brainmask.nii.gz
    $PY code/blockface/registration/linc-register blockface-template --subject <ID>
    $PY code/blockface/registration/linc-register qc --preset bf2b0|direct|bf2bftemplate|b02template|template2template --fixed F --moved M [--warp W] [--mat A ...] [--entry DIR]

Details. The paper's brains keep their masks and starting pose of record (settings/brains/<ID>.yaml registration_to_own_mri); a
new brain (no such entry, or --new-brain) gets an estimated starting pose. An existing registry entry is not replaced unless
--overwrite (the old one is backed up); --registry DIR writes the entry elsewhere. qc's presets set the paper's settings for each
kind of registration: whether the contrasts are inverted (blockface against b0), whether a 180-degree rotation is allowed for in the
rotation limits, and the wider scale limits between animals. For a blockface -> own b0 registration the outline is compared with
the b0 brain mask inside the photographed part of the brain (--slab-iso-mask, with --mat the 9-dof matrix). Parameters:
settings/registration.yaml.
"""
import argparse
import os
import sys
from pathlib import Path

import yaml

REPO = Path(__file__).resolve().parents[3]
sys.path.insert(0, str(REPO / "code"))
from shared import paths, xfm  # noqa: E402


def _entry_free(src, dst, a):
    """Stop before the registration when its registry entry exists and --overwrite was not given."""
    d = xfm.xfm_dir(src, dst, a.subject, a.registry)
    if (d / "meta.json").exists() and not a.overwrite:
        sys.exit(f"the transform entry {d} exists: pass --overwrite to replace it (the old entry is backed up), or --registry DIR")


def mri_route(a):
    from blockface.registration import to_own_mri
    cfg = yaml.safe_load((REPO / "settings" / "registration.yaml").read_text())["to_own_mri"]
    S = a.subject
    if not a.linear_only:
        _entry_free("bf-native", "b0-native", a)
    sub = paths.subject_dir(S); bd, md = sub / "blockface", sub / "mri"
    out = Path(a.out or (paths.work_root() / "register" / S))
    paths.refuse_records(out)                     # never write through a link into the records (code/shared/make_local_data.sh)
    from blockface.subject import subject_yaml
    scfg_p = subject_yaml(S)
    scfg = (yaml.safe_load(scfg_p.read_text()) if scfg_p.exists() else {}).get("registration_to_own_mri")
    bf = dict(final_zarr=str(bd / f"{S}_blockface.ome.zarr"), final_mask=str(bd / f"{S}_mask.nii.gz"),
              iso_grey=str(bd / f"{S}_blockface_iso_grey.nii.gz"), iso_mask=str(bd / f"{S}_mask_iso.nii.gz"))
    _iso_pair(S)
    if a.place_b0:
        if len(a.place_b0) == 2:
            b0_native, mask_native = a.place_b0
        else:                                   # no manual mask: the MRI brain-mask network segments the b0 (code/blockface/registration/mri_mask.py)
            if scfg and not a.new_brain:
                sys.exit(f"{S} has masks of record (settings/brains/{S}.yaml registration_to_own_mri): give --place-b0 B0_NATIVE "
                         "MASK_NATIVE, or --new-brain to treat it as a new brain and segment its b0")
            from blockface.registration import mri_mask
            b0_native = a.place_b0[0]
            mask_native = mri_mask.segment_b0(b0_native, str(md / f"{S}_mri_mask_native_linc_segment.nii.gz"), device=a.device)
        to_own_mri.place_b0(b0_native, mask_native, str(paths.template_root() / "frames" / "mri_template_0p5.nii.gz"), str(md), S,
                             search_deg=int(cfg["b0_placement_search_deg"]))
    mri = dict(placed_b0=str(md / f"{S}_mri.nii.gz"), frame_mask=str(md / f"{S}_mri_mask.nii.gz"),
               b0_native=str(md / f"{S}_mri_b0_native.nii.gz"), mri2template_mat=str(md / f"{S}_mri2template.mat"))
    if scfg and not a.new_brain:
        mri.update(fixed_b0=str(md / scfg["fixed_b0"]), b0_mask=str(md / scfg["b0_mask"]))
        start = scfg["start_pose_world"]
    else:
        mri.update(fixed_b0=mri["placed_b0"], b0_mask=mri["frame_mask"])
        start = to_own_mri.initial_pose(bf["iso_grey"], bf["iso_mask"], mri["placed_b0"], mri["frame_mask"], str(out / "pose"))
    if a.linear_only:
        r = to_own_mri.linear(S, bf, mri, start, str(out / "linear"), cfg)
        print("linear stage:", r["mats"], "slab", r["slab_width_mm"], "mm")
        return
    sub_cfg = yaml.safe_load(scfg_p.read_text()) if scfg_p.exists() else {}
    r = to_own_mri.register(S, bf, mri, start, str(out), cfg, device=a.device, xfm_root=a.registry, overwrite=a.overwrite,
                            crop_mm=float(sub_cfg.get("native_end_crop_mm") or 0.0),
                            vz_mm=float(sub_cfg["vz"]) / 1000.0 if sub_cfg.get("vz") else None)
    print("done:", r["outdir"], "| entry", r["entry"])


def _iso_pair(S):
    """The blockface's isotropic pair, made once beside the reconstruction: the registrations and linc-complete prepare read it there."""
    from blockface.registration import to_own_mri
    bd = paths.subject_dir(S) / "blockface"
    g, m = bd / f"{S}_blockface_iso_grey.nii.gz", bd / f"{S}_mask_iso.nii.gz"
    if not (g.exists() and m.exists()):
        paths.refuse_records(bd)
        iso = float(yaml.safe_load((REPO / "settings" / "registration.yaml").read_text())["to_own_mri"]["iso_mm"])
        to_own_mri.iso_pair(str(bd / f"{S}_blockface.ome.zarr"), str(bd / f"{S}_mask.nii.gz"), str(g), str(m), iso=iso)


def _bf(S):
    bd = paths.subject_dir(S) / "blockface"
    return dict(final_zarr=str(bd / f"{S}_blockface.ome.zarr"), final_mask=str(bd / f"{S}_mask.nii.gz"),
                iso_grey=str(bd / f"{S}_blockface_iso_grey.nii.gz"))


def blockface_template_route(a):
    from blockface.registration import direct
    cfg = yaml.safe_load((REPO / "settings" / "registration.yaml").read_text())["direct"]["to_blockface_template"]
    _entry_free("bf-native", "bf-template", a)
    out = Path(a.out or (paths.work_root() / "register_direct" / a.subject)); out.mkdir(parents=True, exist_ok=True)
    paths.refuse_records(out)                     # never write through a link into the records (code/shared/make_local_data.sh)
    T, P = paths.template_root(), paths.products("products_blockface")["bftemplate_step8"]
    grey, cover = a.template_grey or P / "d2bs8_grey.nii.gz", a.template_coverage or P / "d2bs8_coverage.nii.gz"
    frame, bridge = a.frame or T / "frames" / "mri_template_0p5.nii.gz", a.bridge or T / "bridge_run113_to_canonical" / "linear.json"
    for p in (grey, cover, frame, bridge):
        if not Path(p).exists():
            sys.exit(f"{p} not found: it is part of the template folder ($LINC_TEMPLATE, which settings/roots.sh sets)")
    _iso_pair(a.subject)
    g05, c05 = direct.coarsen_template(grey, cover, frame, str(out / "_template_grey_0.5.nii.gz"), str(out / "_template_coverage_0.5.nii.gz"))
    r = direct.to_blockface_template(a.subject, _bf(a.subject), g05, c05, str(out), cfg, str(bridge), device=a.device, xfm_root=a.registry, overwrite=a.overwrite)
    print("done:", out, "| linear", r.get("linear_used"), "| anchor", r.get("anchor"), "| entry", r.get("entry"))


def direct_placement_route(a):
    from blockface.registration import direct
    cfg = yaml.safe_load((REPO / "settings" / "registration.yaml").read_text())["direct"]["direct_placement"]
    _entry_free("bf-native", "mri-template", a)
    out = Path(a.out or (paths.work_root() / "direct_placement" / a.subject)); out.mkdir(parents=True, exist_ok=True)
    paths.refuse_records(out)                     # never write through a link into the records (code/shared/make_local_data.sh)
    # the stand-in frame, the alignment's last stage: everything it needs is checked here, before the GPU stage
    S, sub = a.subject, paths.subject_dir(a.subject)
    si = sub / "mri" / "stand_in"
    rec = os.environ.get("LINC_DATA_TREE") or os.environ.get("LINC_RECORDS")
    if rec and (os.path.realpath(si) + os.sep).startswith(os.path.realpath(rec).rstrip(os.sep) + os.sep):
        sys.exit(f"{si} is inside the records ({rec}): make your own data folder (code/shared/make_local_data.sh)")
    if si.exists() and not a.overwrite:
        sys.exit(f"{si} exists: pass --overwrite to replace it")
    frame, bridge = paths.template_root() / "frames" / "mri_template_0p5.nii.gz", paths.template_root() / "bridge_run113_to_canonical" / "linear.json"
    own_b0, own_entry = sub / "mri" / f"{S}_mri.nii.gz", xfm.xfm_dir("bf-native", "b0-native", S, a.registry)
    has_b0 = own_b0.exists()
    if has_b0 and not (own_entry / "meta.json").exists():
        sys.exit(f"{S} has its own b0 ({own_b0}) but no registration to it ({own_entry}): run `linc-register mri --subject {S}` first")
    for p in ([] if has_b0 else [frame, bridge]):
        if not p.exists():
            sys.exit(f"{p} not found: it is part of the template folder ($LINC_TEMPLATE, which settings/roots.sh sets)")
    _iso_pair(S)
    r = direct.direct_placement(S, _bf(S), a.template_b0, a.template_mask, str(out), cfg, device=a.device, xfm_root=a.registry, overwrite=a.overwrite,
                                stand_in_dir=str(si), frame=str(frame), bridge_json=str(bridge),
                                own_entry=str(own_entry) if has_b0 else None, own_b0=str(own_b0) if has_b0 else None)
    print("done:", out, "| linear", r.get("linear_used"), "| entry", r.get("entry"), "| stand-in", si)


def qc_route(a):
    import json
    import nibabel as nib
    import numpy as np
    import nibabel.processing as nip
    from blockface.registration import qc as Q
    out = Path(a.out or (paths.work_root() / "qc")); out.mkdir(parents=True, exist_ok=True)
    paths.refuse_records(out)                     # never write through a link into the records (code/shared/make_local_data.sh)
    name = a.name or (Path(a.entry).name if a.entry else Path(a.moved).name.split(".")[0])
    row, F, M, fm, mm = Q.measure(a.fixed, a.moved, warp=a.warp, mat=a.mat, mat_kind=a.mat_kind, mat_src=a.mat_src, mat_ref=a.mat_ref,
                                  fixed_mask=a.fixed_mask, moved_mask=a.moved_mask, eval_mask=a.eval_mask, brain_mask=a.brain_mask,
                                  ncc_fwhm_mm=a.ncc_fwhm_mm, **Q.PRESETS[a.preset])
    row.update(preset=a.preset, name=name)
    if a.outline_target:
        fimg = nib.load(a.fixed)
        T = np.asanyarray(nip.resample_from_to(nib.load(a.outline_target), (fimg.shape[:3], fimg.affine), order=0).dataobj) > 0
        if a.slab_iso_mask:
            if not (a.mat and a.mat_kind == "fsl" and a.mat_src and a.mat_ref):
                sys.exit("--slab-iso-mask needs the 9-dof FLIRT matrix: --mat A --mat-kind fsl --mat-src S --mat-ref R")
            keep, width = Q.photographed_slab(a.mat, a.mat_src, a.mat_ref, a.slab_iso_mask, fimg)
            T &= keep; row["photographed_slab_mm"] = round(width, 3)
        mv = mm if a.moved_mask else (M > 0)
        st, why, ol = Q.outline(mv, T, fimg.affine)
        row["outline"] = dict(status=st, reasons=why, target=a.outline_target, slab_iso_mask=a.slab_iso_mask, regions=ol)
    ok = row["gate_pass"] and row.get("outline", {}).get("status") != "FAIL"
    title = f"{a.preset} | {name} | {'PASS' if ok else 'FAIL'}"
    Q.render_png(str(out / f"{name}.png"), F, M, fm, mm, title, Q.summary_lines(row), ok)
    row["png"] = str(out / f"{name}.png")
    if a.entry:
        xfm.set_qc(a.entry, "pass" if ok else "fail", preset=a.preset, png=row["png"], reasons=row["gate_fail_reasons"]
                   + row.get("outline", {}).get("reasons", []), ncc=row["ncc"], envelope_dice=row["envelope_dice"],
                   outline=row.get("outline", {}).get("status"))
        row["entry"] = str(a.entry)
    (out / f"{name}.json").write_text(json.dumps(row, indent=1, default=float))
    print(f"{'PASS' if ok else 'FAIL'}: {name} -> {out / (name + '.json')}, {row['png']}" + (f"; entry {a.entry}" if a.entry else ""))
    for ln in Q.summary_lines(row):
        print("  " + ln)


def _registry_args(p):
    p.add_argument("--registry", default=None, help="parent folder of the transform entry (default $LINC_DATA/sub-<ID>/xfm)")
    p.add_argument("--overwrite", action="store_true", help="replace an existing transform entry (code/shared/xfm.py backs it up)")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = ap.add_subparsers(dest="route", required=True)
    m = sp.add_parser("mri", help="blockface -> the brain's own b0")
    m.add_argument("--subject", required=True); m.add_argument("--out", default=None); m.add_argument("--device", default="cuda:0")
    m.add_argument("--linear-only", action="store_true", help="steps 2-3 only (CPU)")
    m.add_argument("--new-brain", action="store_true", help="estimate the start pose (ignore a pose of record)")
    m.add_argument("--place-b0", nargs="+", metavar="PATH", default=None,
                   help="B0_NATIVE [MASK_NATIVE]: place the b0 and its brain mask on the template's 0.5 mm grid first "
                        "($LINC_TEMPLATE/frames/mri_template_0p5.nii.gz); "
                        "without MASK_NATIVE the b0 is segmented by the MRI brain-mask network (linc-segment's mri_brainmask; one "
                        "network, no engine switch); a paper brain needs MASK_NATIVE unless --new-brain")
    _registry_args(m)
    sp.add_parser("mri-template", add_help=False, help="the brain's own b0 -> the MRI template's b0 (options: mri-template -h)")
    b = sp.add_parser("blockface-template", help="the blockface-based alignment: blockface -> a blockface template")
    b.add_argument("--subject", required=True)
    b.add_argument("--template-grey", default=None, help="default: the blockface template of record (settings/internal/products_blockface.yaml bftemplate_step8)")
    b.add_argument("--template-coverage", default=None, help="default: its coverage")
    b.add_argument("--frame", default=None, help="the 0.5 mm frame the template is the 2x refinement of (default $LINC_TEMPLATE/frames/mri_template_0p5.nii.gz)")
    b.add_argument("--bridge", default=None, help="the run-113 -> canonical bridge, for the flat brainstem cut (default $LINC_TEMPLATE/bridge_run113_to_canonical/linear.json)")
    b.add_argument("--out", default=None); b.add_argument("--device", default="cuda:0")
    _registry_args(b)
    d = sp.add_parser("direct-placement", help="the cross-modal alignment: blockface -> the MRI template's b0")
    d.add_argument("--subject", required=True); d.add_argument("--template-b0", required=True); d.add_argument("--template-mask", required=True)
    d.add_argument("--out", default=None); d.add_argument("--device", default="cuda:0")
    _registry_args(d)
    q = sp.add_parser("qc", help="the paper's registration QC of one registration (gate, outline, PNG; optionally into its registry entry)")
    q.add_argument("--preset", required=True, choices=["bf2b0", "direct", "bf2bftemplate", "b02template", "template2template"],
                   help="bf2b0: blockface -> own b0; direct: blockface -> MRI template; bf2bftemplate: blockface -> blockface template; b02template: b0 -> MRI template; template2template: blockface template -> MRI template")
    q.add_argument("--fixed", required=True); q.add_argument("--moved", required=True, help="the moved image on (or resampled to) the fixed grid")
    q.add_argument("--warp"); q.add_argument("--mat"); q.add_argument("--mat-kind", default="fsl", choices=["fsl", "world", "itk"])
    q.add_argument("--mat-src", help="FLIRT matrix: its moving image"); q.add_argument("--mat-ref", help="FLIRT matrix: its reference image")
    q.add_argument("--fixed-mask"); q.add_argument("--moved-mask"); q.add_argument("--eval-mask"); q.add_argument("--brain-mask")
    q.add_argument("--ncc-fwhm-mm", type=float, help="NCC at a matched bandwidth (the coarser acquisition's FWHM)")
    q.add_argument("--outline-target", help="the target brain mask of the outline check (resampled nearest onto the fixed grid)")
    q.add_argument("--slab-iso-mask", help="blockface -> own b0: the blockface's isotropic mask; the target is cut to the photographed slab")
    q.add_argument("--entry", help="the registration's registry entry: record pass / fail there (code/shared/xfm.py set_qc)")
    q.add_argument("--out", default=None, help="folder of the JSON row and PNG (default $LINC_WORK/qc)"); q.add_argument("--name")
    a, rest = ap.parse_known_args()
    if getattr(a, "place_b0", None) and len(a.place_b0) > 2:
        ap.error("--place-b0 takes B0_NATIVE and, optionally, MASK_NATIVE")
    if a.route == "mri-template":                                       # its options are defined by code/template/link/b0_to_template.py
        from template.link import b0_to_template
        return b0_to_template.main(rest, prog="linc-register mri-template")
    if rest:
        ap.error(f"unrecognized arguments: {' '.join(rest)}")
    {"mri": mri_route, "blockface-template": blockface_template_route, "direct-placement": direct_placement_route, "qc": qc_route}[a.route](a)


if __name__ == "__main__":
    main()
