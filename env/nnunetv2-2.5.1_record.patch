diff -ruN a/nnunetv2/training/nnUNetTrainer/variants/data_augmentation/nnUNetTrainerDA5_shortsched.py b/nnunetv2/training/nnUNetTrainer/variants/data_augmentation/nnUNetTrainerDA5_shortsched.py
--- a/nnunetv2/training/nnUNetTrainer/variants/data_augmentation/nnUNetTrainerDA5_shortsched.py
+++ b/nnunetv2/training/nnUNetTrainer/variants/data_augmentation/nnUNetTrainerDA5_shortsched.py
@@ -0,0 +1,38 @@
+"""DA5 augmentation on a shorter, fully-annealed schedule.
+
+nnU-Net ships heavy augmentation (nnUNetTrainerDA5) and it ships short schedules
+(nnUNetTrainer_500epochs and friends), but never the two together: every epoch variant subclasses
+the PLAIN trainer, so picking one silently drops back to default augmentation.
+
+This matters when there is a deadline. nnU-Net's learning rate follows a polynomial decay over
+`num_epochs`, so simply killing a 1000-epoch run early leaves the weights at a LR that was still
+mid-schedule -- the model never anneals. Declaring the shorter budget up front lets the schedule
+complete, which is a strictly better model than the same wall-clock spent on a truncated long run.
+
+Additive only: new file, new class names, nothing existing is touched. Remove the file to revert.
+Source of record: LINC_template/code/mrimask/trainers/ -- install.sh copies it into the env.
+"""
+import torch
+
+from nnunetv2.training.nnUNetTrainer.variants.data_augmentation.nnUNetTrainerDA5 import nnUNetTrainerDA5
+
+
+class nnUNetTrainerDA5_600epochs(nnUNetTrainerDA5):
+    def __init__(self, plans: dict, configuration: str, fold: int, dataset_json: dict,
+                 unpack_dataset: bool = True, device: torch.device = torch.device('cuda')):
+        super().__init__(plans, configuration, fold, dataset_json, unpack_dataset, device)
+        self.num_epochs = 600
+
+
+class nnUNetTrainerDA5_400epochs(nnUNetTrainerDA5):
+    def __init__(self, plans: dict, configuration: str, fold: int, dataset_json: dict,
+                 unpack_dataset: bool = True, device: torch.device = torch.device('cuda')):
+        super().__init__(plans, configuration, fold, dataset_json, unpack_dataset, device)
+        self.num_epochs = 400
+
+
+class nnUNetTrainerDA5_250epochs(nnUNetTrainerDA5):
+    def __init__(self, plans: dict, configuration: str, fold: int, dataset_json: dict,
+                 unpack_dataset: bool = True, device: torch.device = torch.device('cuda')):
+        super().__init__(plans, configuration, fold, dataset_json, unpack_dataset, device)
+        self.num_epochs = 250
