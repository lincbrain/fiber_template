  "finish": {
   "join": "a PLANE per brain, the clean cut face z_f (clean_face.py, protocol v2.1 section 2); every voxel caudal of it is synthesized, including the photographed but incomplete tissue between the most caudal photographed plane and z_f",
   "clean_face_rule": {
    "tau": 0.95,
    "window_mm": 40.0,
    "margin_mm": 1.5,
    "erode_mm": 1.0,
    "grid": "flat deploy grid (axis 1 = A-P, caudal low)",
    "complete": "real_mask covers >= tau of the brain mask eroded by erode_mm in the plane",
    "z_c": "most caudal plane with every plane over the next window_mm complete",
    "z_f": "z_c + margin_mm",
    "dstar": "photographed volume of the planes [z_f, z_f + d*) = brain volume caudal of z_f"
   },
   "intensity": "one monotone (isotonic, PAVA) map per brain from the network output to the photographs' grey, fitted on the first 8 mm of fully photographed tissue (photo fraction >= 0.999) rostral of z_f; no per-column scaling, no clipped factor",
   "recal_band_mm": 8.0,
   "recal_photo_fraction": 0.999,
   "crossfade": "cosine ramp over 2 mm rostral of z_f on retained photographed tissue: w = 0.5 - 0.5 cos(pi * clip(d / 2 mm, 0, 1)); completed = w * photograph + (1 - w) * synthesis",
   "crossfade_mm": 2.0,
   "colour": "constant chroma per brain (deploy.py's rule)",
   "per_brain_keys": [
    "z_f_mm_from_photographed_end",
    "photographed_discarded_ml",
    "true_gap_mm",
    "missing_ml"
   ]
  },
